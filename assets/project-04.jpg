<style>.photo-proof{padding:80px 7vw;display:grid;grid-template-columns:1.15fr .85fr;gap:44px;align-items:center;background:#fffaf3}.photo-proof img{width:100%;display:block;border-radius:28px;box-shadow:0 24px 70px rgba(50,45,40,.14)}.photo-proof h2{font-size:clamp(34px,4vw,60px);line-height:1.08;letter-spacing:-.04em;margin:8px 0 18px}.photo-proof p{color:#6f6a61}@media(max-width:900px){.photo-proof{grid-template-columns:1fr;padding:70px 6vw}}</style>